rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cho phép đọc ghi cho hệ thống quản trị và xác thực thành viên
    match /system_config/{document} {
      allow read, write: if true;
    }
    match /members/{memberId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
